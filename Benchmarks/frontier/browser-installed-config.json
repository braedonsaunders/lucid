{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "chrome",
      "headless": false,
      "args": [
        "--autoplay-policy=no-user-gesture-required",
        "--enable-unsafe-extension-debugging"
      ],
      "ignoreDefaultArgs": [
        "--disable-extensions"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 900,
        "height": 700
      },
      "deviceScaleFactor": 2
    }
  }
}
